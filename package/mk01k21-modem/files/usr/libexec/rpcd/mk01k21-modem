#!/bin/sh

# rpcd exec backend for the Mesh MK01K21 Quectel RM520N modem.
# Every AT operation is serialized and receives the command as one argv item.

[ "${MK01K21_MODEM_TEST:-0}" = "1" ] || . /usr/share/libubox/jshn.sh

LOCK_DIR=/tmp/mk01k21-modem.lock
LOCK_STALE_MIN=5
LOCK_HELD=0
MAX_AT_LENGTH=256
AT_ATTEMPTS=0
AT_FAILURES=0

config_get() {
	uci -q get "mk01k21-modem.main.$1" 2>/dev/null || printf '%s' "$2"
}

valid_port() {
	printf '%s' "$1" | grep -Eq '^/dev/tty(USB|ACM)[0-9]+$'
}

valid_uci_name() {
	printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_]+$'
}

# An SMS destination: optional leading +, then 3-20 digits. Deliberately
# strict -- the number is passed to sms_tool as its own argv item (never
# through a shell), and this rejects anything that is not a plain MSISDN.
valid_phone_number() {
	printf '%s' "$1" | grep -Eq '^\+?[0-9]{3,20}$'
}

# An SMS body. Passed to sms_tool as one argv item, so shell metacharacters are
# not a concern; what is rejected is control characters (except the newlines a
# multi-line message legitimately contains) and an over-long body. sms_tool
# splits long GSM-7/UCS-2 messages into concatenated parts itself, so the cap
# here is a sanity bound, not the single-SMS 160-character limit.
MAX_SMS_LENGTH=1600
valid_sms_body() {
	local body="$1"
	[ -n "$body" ] || return 1
	[ "${#body}" -le "$MAX_SMS_LENGTH" ] || return 1
	# Reject control characters, but allow the newlines a multi-line message
	# legitimately contains. tr is fed a LITERAL newline (not the '\n' escape,
	# whose interpretation is tr-implementation dependent) so the newline is
	# stripped before the control-character test on every tr.
	printf '%s' "$body" | LC_ALL=C tr -d '
' | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
	return 0
}

# An SMS index for deletion: a non-negative integer, or the literal "all".
valid_sms_index() {
	case "$1" in
		all) return 0 ;;
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_at_command() {
	local command="$1"
	[ -n "$command" ] || return 1
	[ "${#command}" -le "$MAX_AT_LENGTH" ] || return 1
	case "$command" in
		AT|AT*) ;;
		*) return 1 ;;
	esac
	[ "$(printf '%s' "$command" | wc -l)" -eq 0 ] || return 1
	printf '%s' "$command" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
	return 0
}

lock_owner() {
	cat "$LOCK_DIR/pid" 2>/dev/null
}

# Claim the lock. mkdir is the atomic gate: exactly one caller can create the
# directory. The pid is published via a rename so it appears atomically and a
# reader never sees a half-written value.
claim_lock() {
	mkdir "$LOCK_DIR" 2>/dev/null || return 1
	printf '%s\n' "$$" > "$LOCK_DIR/pid.$$" 2>/dev/null
	mv "$LOCK_DIR/pid.$$" "$LOCK_DIR/pid" 2>/dev/null
	LOCK_HELD=1
	return 0
}

# Is this pid still running? /proc is authoritative and, unlike "kill -0",
# permission-independent: kill -0 against a process owned by another user
# fails with EPERM, which would wrongly look like "the owner is gone" and
# hand the serial port to a second caller.
process_alive() {
	local pid="$1"
	[ -n "$pid" ] || return 1
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ -d /proc ] && { [ -d "/proc/$pid" ]; return $?; }
	kill -0 "$pid" 2>/dev/null
}

lock_is_stale() {
	local owner="$1"

	if [ -n "$owner" ]; then
		# A live owner is never stale.
		process_alive "$owner" && return 1
		return 0
	fi

	# No pid published yet. The winner of mkdir writes it within microseconds,
	# so treat this as HELD rather than stale - assuming stale here is exactly
	# how two callers end up on the serial port at once. Only an owner killed
	# inside that window leaves the directory pidless, so fall back to age.
	[ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin "+$LOCK_STALE_MIN" 2>/dev/null)" ]
}

acquire_lock() {
	local owner graveyard

	claim_lock && return 0

	owner="$(lock_owner)"
	lock_is_stale "$owner" || return 1

	# Reclaim a stale lock by RENAMING it, never by removing it in place.
	# rename is atomic, so when two callers race here only one moves the
	# directory; the loser's mv fails and it simply retries mkdir. Removing
	# "$LOCK_DIR" directly would let one caller delete a lock another caller
	# had already legitimately re-created.
	graveyard="$LOCK_DIR.stale.$$"
	mv "$LOCK_DIR" "$graveyard" 2>/dev/null && rm -rf "$graveyard"

	claim_lock
}

release_lock() {
	# Only ever release a lock this process actually owns.
	[ "$LOCK_HELD" = "1" ] || return 0
	[ "$(lock_owner)" = "$$" ] || return 0
	LOCK_HELD=0
	rm -rf "$LOCK_DIR"
}

run_at() {
	local port="$1"
	local command="$2"
	local timeout_seconds
	timeout_seconds="$(config_get at_timeout 8)"
	timeout "$timeout_seconds" sms_tool -d "$port" at "$command" 2>&1
}

json_error() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
}

require_port() {
	local port="$1"
	valid_port "$port" && [ -c "$port" ]
}

add_at_result() {
	local name="$1"
	local command="$2"
	local port="$3"
	local output rc
	output="$(run_at "$port" "$command")"
	rc=$?
	AT_ATTEMPTS=$((AT_ATTEMPTS + 1))
	[ "$rc" -eq 0 ] || AT_FAILURES=$((AT_FAILURES + 1))
	json_add_string "$name" "$output"
}

add_at_health() {
	json_add_int at_attempts "$AT_ATTEMPTS"
	json_add_int at_failures "$AT_FAILURES"
	if [ "$AT_FAILURES" -le 0 ]; then
		json_add_boolean at_degraded 0
		return
	fi
	json_add_boolean at_degraded 1
	if [ "$AT_FAILURES" -ge "$AT_ATTEMPTS" ]; then
		json_add_string at_error "The modem did not answer any AT command on $1. It may be resetting or re-enumerating on USB."
	else
		json_add_string at_error "$AT_FAILURES of $AT_ATTEMPTS AT commands failed or timed out."
	fi
}

network_get() {
	uci -q get "network.$1.$2" 2>/dev/null || printf '%s' "$3"
}

add_usb_identity() {
	local path vendor product manufacturer model
	for path in /sys/bus/usb/devices/*; do
		[ -r "$path/idVendor" ] && [ -r "$path/idProduct" ] || continue
		vendor="$(cat "$path/idVendor" 2>/dev/null)"
		[ "$vendor" = "2c7c" ] || continue
		product="$(cat "$path/idProduct" 2>/dev/null)"
		manufacturer="$(cat "$path/manufacturer" 2>/dev/null)"
		model="$(cat "$path/product" 2>/dev/null)"
		json_add_string usb_id "$vendor:$product"
		json_add_string usb_manufacturer "$manufacturer"
		json_add_string usb_product "$model"
		return
	done
}

handle_status() {
	local input full port interface wdm network_json apn pdptype
	input="$(cat)"
	json_load "${input:-{}}" || {
		json_error "Invalid request"
		return
	}
	json_get_var full full
	port="$(config_get at_port /dev/ttyUSB2)"
	interface="$(config_get interface wan_cellular)"
	valid_uci_name "$interface" || {
		json_error "Configured cellular interface name is invalid: $interface"
		return
	}
	# The authoritative control device is the one the interface actually uses;
	# the local option is only a fallback for a not-yet-configured interface.
	wdm="$(network_get "$interface" device "$(config_get wdm_device /dev/cdc-wdm0)")"
	apn="$(network_get "$interface" apn '')"
	pdptype="$(network_get "$interface" pdptype ipv4)"

	require_port "$port" || {
		json_error "Configured AT port is unavailable: $port"
		return
	}
	acquire_lock || {
		json_error "The modem is busy; try again shortly"
		return
	}
	trap release_lock EXIT INT TERM

	network_json="$(ubus call "network.interface.$interface" status 2>/dev/null || printf '{}')"
	json_init
	json_add_boolean ok 1
	json_add_string at_port "$port"
	json_add_string wdm_device "$wdm"
	json_add_string interface "$interface"
	json_add_string apn "$apn"
	json_add_string pdptype "$pdptype"
	json_add_string network_json "$network_json"
	json_add_int timestamp "$(date +%s)"
	add_usb_identity
	if [ "$full" = "1" ]; then
		add_at_result identity 'ATI' "$port"
		add_at_result model 'AT+CGMM' "$port"
		add_at_result firmware 'AT+GMR' "$port"
		add_at_result imei 'AT+CGSN' "$port"
		add_at_result imsi 'AT+CIMI' "$port"
		add_at_result iccid 'AT+QCCID' "$port"
		add_at_result phone_number 'AT+CNUM' "$port"
		add_at_result sim 'AT+CPIN?' "$port"
		# The service provider name from the SIM. Deliberately inside the "full"
		# block: AT+COPS reports the operator as a numeric PLMN on this firmware
		# (format 2), and the readable name has to come from somewhere -- but it
		# does not change while attached, so it is fetched once on page load
		# rather than on every poll, which would hold the serial lock for longer
		# on each refresh for a value that never moves.
		add_at_result spn 'AT+QSPN' "$port"
	fi
	add_at_result operator 'AT+COPS?' "$port"
	add_at_result csq 'AT+CSQ' "$port"
	add_at_result qcsq 'AT+QCSQ' "$port"
	add_at_result qrsrp 'AT+QRSRP' "$port"
	add_at_result network_info 'AT+QNWINFO' "$port"
	add_at_result serving_cell 'AT+QENG="servingcell"' "$port"
	add_at_result carrier_aggregation 'AT+QCAINFO' "$port"
	add_at_result temperature 'AT+QTEMP' "$port"
	add_at_health "$port"
	json_dump
}

handle_at() {
	local input command port output rc
	input="$(cat)"
	json_load "${input:-{}}" || {
		json_error "Invalid request"
		return
	}
	json_get_var command command
	valid_at_command "$command" || {
		json_error "Commands must start with AT, contain no control characters, and be at most $MAX_AT_LENGTH characters"
		return
	}

	port="$(config_get at_port /dev/ttyUSB2)"
	require_port "$port" || {
		json_error "Configured AT port is unavailable: $port"
		return
	}
	acquire_lock || {
		json_error "The modem is busy; try again shortly"
		return
	}
	trap release_lock EXIT INT TERM

	output="$(run_at "$port" "$command")"
	rc=$?
	json_init
	[ "$rc" -eq 0 ] && json_add_boolean ok 1 || json_add_boolean ok 0
	json_add_int code "$rc"
	json_add_string command "$command"
	json_add_string output "$output"
	[ "$rc" -eq 0 ] || json_add_string error "The modem command failed or timed out"
	json_dump
}

handle_power() {
	local input action port output rc
	input="$(cat)"
	json_load "${input:-{}}" || {
		json_error "Invalid request"
		return
	}
	json_get_var action action

	case "$action" in
		restart)
			port="$(config_get at_port /dev/ttyUSB2)"
			require_port "$port" || {
				json_error "Configured AT port is unavailable: $port"
				return
			}
			acquire_lock || {
				json_error "The modem is busy; try again shortly"
				return
			}
			trap release_lock EXIT INT TERM
			output="$(run_at "$port" 'AT+CFUN=1,1')"
			rc=$?
			;;
		cycle)
			# Not exposed. On this board the OEM device tree names GPIO 6
			# "gpio_pcie0_power", and PCIe0 carries the MT7915 DBDC host
			# interface, so driving this line at runtime most likely drops
			# both Wi-Fi bands rather than power-cycling the modem. ROOTer
			# ships no configured modem-power GPIO for this board either and
			# recovers over AT instead. Use the "restart" action; for
			# deliberate, supervised identification of the line, invoke
			# /usr/libexec/mk01k21-pcie0-power-probe from a shell. It is
			# deliberately not an init script: as a service it appeared on
			# LuCI's System -> Startup page with a one-click Stop, and being
			# enabled would have written to the line on every clean shutdown.
			json_error "GPIO power cycling is disabled on this board: the modem power line is not identified"
			return
			;;
		*)
			json_error "Unsupported recovery action"
			return
			;;
	esac

	json_init
	[ "$rc" -eq 0 ] && json_add_boolean ok 1 || json_add_boolean ok 0
	json_add_int code "$rc"
	json_add_string action "$action"
	json_add_string output "$output"
	[ "$rc" -eq 0 ] || json_add_string error "The recovery action failed"
	json_dump
}

handle_rat() {
	local port output
	port="$(config_get at_port /dev/ttyUSB2)"
	require_port "$port" || {
		json_error "Configured AT port is unavailable: $port"
		return
	}
	acquire_lock || {
		json_error "The modem is busy; try again shortly"
		return
	}
	trap release_lock EXIT INT TERM

	# Deliberately ONE command. This exists so the LED helper can learn the
	# radio access technology without running the full status sweep, and
	# without opening the serial port outside this lock.
	output="$(run_at "$port" 'AT+QNWINFO')"
	json_init
	json_add_boolean ok 1
	json_add_string output "$output"
	case "$output" in
		*NR5G*) json_add_string rat "5G" ;;
		*LTE*)  json_add_string rat "LTE" ;;
		*WCDMA*|*HSPA*) json_add_string rat "3G" ;;
		*) json_add_string rat "" ;;
	esac
	json_dump
}

# Run one sms_tool subcommand against the configured port. The caller passes
# the subcommand and its arguments as separate positional parameters, so no
# value is ever interpreted by a shell. -j asks for JSON output on recv. The
# port is opened by sms_tool itself, which is exactly why every call sits
# inside the one serial lock, like every AT path.
run_sms() {
	local port="$1"; shift
	local timeout_seconds
	# SMS gets its own, longer budget: a send waits on network acknowledgement
	# and a large recv can be slow, both routinely past the 8 s AT timeout.
	timeout_seconds="$(config_get sms_timeout 45)"
	timeout "$timeout_seconds" sms_tool -d "$port" "$@" 2>&1
}

# SMS: list (recv), send, delete, status (storage usage). One method, dispatched
# by action, each acquiring the ONE serial lock before touching the modem. This
# is on-demand only -- opening the SMS page runs one locked recv. There is
# deliberately no background poller yet: a poll for unsolicited +CMTI would
# contend with the status sweep for the lock and needs its own careful design
# (see README section 8).
handle_sms() {
	local input action port number message index output rc
	input="$(cat)"
	json_load "${input:-{}}" || {
		json_error "Invalid request"
		return
	}
	json_get_var action action

	port="$(config_get at_port /dev/ttyUSB2)"
	require_port "$port" || {
		json_error "Configured AT port is unavailable: $port"
		return
	}

	# Validate BEFORE taking the lock, so a bad request never holds the port.
	case "$action" in
		list|status) ;;
		send)
			json_get_var number number
			json_get_var message message
			valid_phone_number "$number" || {
				json_error "Destination must be an optional + followed by 3-20 digits"
				return
			}
			valid_sms_body "$message" || {
				json_error "Message must be non-empty, at most $MAX_SMS_LENGTH characters, and free of control characters"
				return
			}
			;;
		delete)
			json_get_var index index
			valid_sms_index "$index" || {
				json_error "Delete requires a message index or the word all"
				return
			}
			;;
		*)
			json_error "Unsupported SMS action"
			return
			;;
	esac

	acquire_lock || {
		json_error "The modem is busy; try again shortly"
		return
	}
	trap release_lock EXIT INT TERM

	case "$action" in
		list)   output="$(run_sms "$port" -j recv)"; rc=$? ;;
		status) output="$(run_sms "$port" status)"; rc=$? ;;
		send)   output="$(run_sms "$port" send "$number" "$message")"; rc=$? ;;
		delete) output="$(run_sms "$port" delete "$index")"; rc=$? ;;
	esac

	json_init
	[ "$rc" -eq 0 ] && json_add_boolean ok 1 || json_add_boolean ok 0
	json_add_int code "$rc"
	json_add_string action "$action"
	json_add_string output "$output"
	[ "$rc" -eq 0 ] || json_add_string error "The SMS operation failed or timed out"
	json_dump
}

handle_ports() {
	local path
	json_init
	json_add_boolean ok 1
	json_add_array at_ports
	for path in /dev/ttyUSB* /dev/ttyACM*; do
		[ -c "$path" ] && json_add_string "" "$path"
	done
	json_close_array
	json_add_array wdm_devices
	for path in /dev/cdc-wdm*; do
		[ -c "$path" ] && json_add_string "" "$path"
	done
	json_close_array
	json_dump
}

main() {
	case "$1" in
		list)
			printf '%s\n' '{"status":{"full":"Boolean"},"at":{"command":"String"},"power":{"action":"String"},"sms":{"action":"String","number":"String","message":"String","index":"String"},"ports":{},"rat":{}}'
			;;
		call)
			case "$2" in
				status) handle_status ;;
				at) handle_at ;;
				power) handle_power ;;
				sms) handle_sms ;;
				ports) handle_ports ;;
				rat) handle_rat ;;
				*) json_error "Unknown method" ;;
			esac
			;;
		*) exit 1 ;;
	esac
}

if [ "${MK01K21_MODEM_TEST:-0}" = "1" ]; then
	return 0 2>/dev/null || exit 0
fi
main "$@"
