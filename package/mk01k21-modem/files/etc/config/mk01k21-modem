config modem 'main'
	option at_port '/dev/ttyUSB2'
	# Fallback only. The live control device is read from
	# network.<interface>.device; this is used before that exists.
	option wdm_device '/dev/cdc-wdm0'
	option interface 'wan_cellular'
	option refresh_interval '30'
	option mask_identifiers '1'
	option at_timeout '8'
	# SMS operations are NOT bounded by at_timeout: an SMS submit waits on the
	# network's acknowledgement and a full-inbox recv can take tens of seconds,
	# both routinely longer than the 8 s a single AT command is given. Killing
	# sms_tool mid-send is the dangerous failure -- the message may already have
	# gone, the UI reports failure, and the user sends it twice.
	option sms_timeout '45'

# Connection watchdog. OpenWrt's MBIM handler recovers from a clean link drop,
# but not from "interface up, no data flowing" -- the common cellular stall.
# This service pings out through the cellular interface and, when data has
# really stopped, escalates through recovery rungs, each heavier than the last,
# stopping the moment connectivity returns.
#
# Disabled by default: it acts on the live data path, so it is opt-in. Every
# value below is a starting default to be tuned against real device behaviour,
# not a measured constant.
#
#   enabled          0/1, master switch (backs the mk_watchdog_disabled control)
#   interval         seconds between reachability checks
#   fail_threshold   consecutive failed checks before the first recovery rung
#   targets          space-separated IPs; ALL must fail for a check to count as
#                    down, so one dead host is not a false alarm
#   ping_count       ICMP echoes per target per check
#   ping_timeout     seconds to wait for a target to answer
#   rung2_cooldown   seconds to let ifdown/ifup recover before rung 3 is tried
#   rung3_cooldown   seconds to let AT+CFUN=1,1 re-attach before re-escalating
#   max_reboot       reserved and unused: the reboot rung is deliberately NOT
#                    built (see README section 8)
config watchdog 'watchdog'
	option enabled '0'
	option interval '30'
	option fail_threshold '3'
	option targets '1.1.1.1 8.8.8.8'
	option ping_count '1'
	option ping_timeout '3'
	option rung2_cooldown '45'
	option rung3_cooldown '60'
