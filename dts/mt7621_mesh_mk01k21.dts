/dts-v1/;

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "mesh,mk01k21", "mediatek,mt7621-soc";
	model = "Mesh MK01K21";

	aliases {
		led-boot = &led_top_5gblue;
		led-failsafe = &led_top_5gred;
		led-running = &led_top_5gblue;
		led-upgrade = &led_top_5gred;
		label-mac-device = &gmac0;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>; /* 256MB DDR3 */
	};

	/* Modem Power Supply (GPIO 6 Active HIGH) */
	reg_modem: regulator-modem {
		compatible = "regulator-fixed";
		regulator-name = "modem_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	/* OEM gpio-export compatibility node */
	gpio-export {
		compatible = "gpio-export";

		gpio_pcie0_power {
			gpio-export,output = <0>;
			gpios = <&gpio 6 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Keys identical to OEM DTS */
	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio 10 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		rfkill {
			label = "rfkill";
			gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
		};
	};

	/* LEDs identical to OEM DTS */
	leds {
		compatible = "gpio-leds";

		led_top_5gblue: status {
			label = "top:5gblue";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		led_top_5gred: 5gred {
			label = "top:5gred";
			gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
		};

		wifi {
			label = "blue:wifi";
			gpios = <&gpio 0 GPIO_ACTIVE_HIGH>;
		};

		5gblue {
			label = "led:5gblue";
			gpios = <&gpio 9 GPIO_ACTIVE_HIGH>;
		};

		5gorange {
			label = "led:5gorange";
			gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
		};

		4gblue {
			label = "led:4gblue";
			gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
		};

		4gorange {
			label = "led:4gorange";
			gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * Critical MT7621 Pinctrl:
 * - "rgmii2" (GPIO 22-33): Muxed to "gpio" to eliminate GMAC1 interference with switch GMAC0.
 * - "sdhci" (GPIO 18-21): Muxed to "gpio" so GPIO 18 (reset button) works.
 * - "wdt", "jtag", "uart3": Muxed to "gpio" matching OEM behavior.
 */
&state_default {
	gpio {
		groups = "i2c", "uart2", "uart3", "rgmii2", "sdhci", "wdt", "jtag";
		function = "gpio";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x00000000 0x00030000>; /* 192KB */
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x00030000 0x00010000>; /* 64KB */
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x00040000 0x00010000>; /* 64KB calibration data */
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* OEM MAC address stored at offset 0xc00 */
					macaddr_factory_c00: macaddr@c00 {
						reg = <0xc00 0x6>;
					};
				};
			};

			partition@50000 {
				compatible = "openwrt,uimage", "denx,uimage";
				label = "firmware";
				reg = <0x00050000 0x00fb0000>; /* 16064KB */
			};
		};
	};
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_c00>;
	nvmem-cell-names = "mac-address";
};

/*
 * Exact 3-Port DSA Switch Map (confirmed from OEM DTS):
 * - Port 0: wan (MAC at 0xc00 + 1)
 * - Port 1: lan2
 * - Port 2: lan1
 * - Port 3, 4: Disabled
 */
&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "wan";
			nvmem-cells = <&macaddr_factory_c00>;
			nvmem-cell-names = "mac-address";
			mac-address-increment = <1>;
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan1";
		};

		port@3 {
			status = "disabled";
		};

		port@4 {
			status = "disabled";
		};
	};
};

/* USB 3.0 / 2.0 Host Controller for Quectel RM520N-GL */
&xhci {
	status = "okay";
};

/* PCIe Controller with OEM reset-gpios (GPIO 19 Active LOW) */
&pcie {
	status = "okay";
	reset-gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
};

&pcie0 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&macaddr_factory_c00>;
        nvmem-cell-names = "mac-address";
	};
};

&pcie1 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&macaddr_factory_c00>;
        nvmem-cell-names = "mac-address";
	};
};
