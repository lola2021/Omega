/dts-v1/;

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "mesh,mk01k21", "mediatek,mt7621-soc";
	model = "Mesh MK01K21 (AlwayWireless 5G CPE)";

	aliases {
		led-boot = &led_top_5gblue;
		led-failsafe = &led_top_5gred;
		led-running = &led_top_5gblue;
		led-upgrade = &led_top_5gred;
		label-mac-device = &gmac0;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>; /* 256MB DDR3 */
	};

	/*
	 * Modem Power Supply (GPIO 6 Active HIGH):
	 * Controls power to the 5G WWAN M.2 module.
	 */
	reg_modem: regulator-modem {
		compatible = "regulator-fixed";
		regulator-name = "modem_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	/* Keys identified from live debug/gpio */
	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		key-wps {
			label = "wps";
			gpios = <&gpio 10 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		key-rfkill {
			label = "rfkill";
			gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RFKILL>;
		};
	};

	/* LEDs identified from live debug/gpio */
	leds {
		compatible = "gpio-leds";

		wifi {
			label = "blue:wifi";
			gpios = <&gpio 0 GPIO_ACTIVE_HIGH>;
		};

		led_5gblue: 5gblue {
			label = "blue:5g";
			gpios = <&gpio 9 GPIO_ACTIVE_HIGH>;
		};

		led_4gblue: 4gblue {
			label = "blue:4g";
			gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
		};

		led_5gorange: 5gorange {
			label = "orange:5g";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		led_top_5gblue: top_5gblue {
			label = "blue:top5g";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};

		led_top_5gred: top_5gred {
			label = "red:top5g";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
		};

		led_4gorange: 4gorange {
			label = "orange:4g";
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * Critical MT7621 Pinctrl Fix:
 * - "rgmii2" (GPIO 22-33): Muxed to "gpio" to eliminate GMAC1 interference with switch GMAC0.
 * - "sdhci" (GPIO 18-21): Muxed to "gpio" so GPIO 18 (reset) and GPIO 19 receive interrupts.
 * - "i2c", "uart2", "uart3", "wdt": Released for LEDs and buttons.
 */
&state_default {
	gpio {
		groups = "i2c", "uart2", "uart3", "rgmii2", "sdhci", "wdt";
		function = "gpio";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x00000000 0x00030000>; /* 192KB */
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x00030000 0x00010000>; /* 64KB */
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x00040000 0x00010000>; /* 64KB */
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* OEM MAC address stored at offset 0xc00 */
					macaddr_factory_c00: macaddr@c00 {
						reg = <0xc00 0x6>;
					};

					/* MT7915 / MT7916 EEPROM calibration cells */
					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x1000>;
					};

					eeprom_factory_8000: eeprom@8000 {
						reg = <0x8000 0x1000>;
					};
				};
			};

			partition@50000 {
				compatible = "openwrt,uimage", "denx,uimage";
				label = "firmware";
				reg = <0x00050000 0x00fb0000>; /* 16064KB */
			};
		};
	};
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_c00>;
	nvmem-cell-names = "mac-address";
};

/*
 * Exact 3-Port DSA Switch Map confirmed from OEM / ROOter live system:
 * - Port 0: wan (eth0 port 0, MAC + 1)
 * - Port 1: lan2 (eth0 port 1)
 * - Port 2: lan1 (eth0 port 2)
 * - Port 3, 4: Disabled
 */
&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "wan";
			nvmem-cells = <&macaddr_factory_c00>;
			nvmem-cell-names = "mac-address";
			mac-address-increment = <1>;
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan1";
		};

		port@3 {
			status = "disabled";
		};

		port@4 {
			status = "disabled";
		};
	};
};

/* USB 3.0 / 2.0 Host Controller for 5G Modem */
&xhci {
	status = "okay";
};

/* PCIe Controller for MT7915 / MT7916 Wi-Fi */
&pcie {
	status = "okay";
};

&pcie0 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>, <&macaddr_factory_c00>;
		nvmem-cell-names = "eeprom", "mac-address";
	};
};
