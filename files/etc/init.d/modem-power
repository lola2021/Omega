#!/bin/sh /etc/rc.common
# Controls the active-low MK01K21 modem power-enable line exported by the DTS.

START=15
STOP=90

GPIO_PATH=/sys/class/gpio/modem-power

set_power() {
	local value="$1"

	[ -w "$GPIO_PATH/value" ] || {
		echo "modem-power GPIO export is unavailable" >&2
		return 1
	}

	# GPIO 6 is active low: 0 powers the modem on; 1 powers it off.
	echo "$value" > "$GPIO_PATH/value"
}

start() {
	set_power 0
}

stop() {
	set_power 1
}

restart() {
	set_power 1 || return
	sleep 2
	set_power 0
}
