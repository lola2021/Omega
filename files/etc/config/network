config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00::/48'
	# Spread receive processing across both MIPS cores instead of pinning it to
	# CPU0. Worth having here because the cellular WAN arrives over USB, and USB
	# interrupt handling on one core is a real bottleneck on this SoC. Toggle it
	# under Network -> Interfaces -> Global network options if it ever hurts.
	option packet_steering '1'

config device 'br-lan'
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option metric '20'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'
	option metric '20'

# ==============================================================================
# MBIM Cellular Interface Configuration
# ==============================================================================
config interface 'wan_cellular'
	option proto 'mbim'
	option device '/dev/cdc-wdm0'
	option apn 'internet'
	option pdptype 'ipv4'
	option metric '10'
	option auto '1'
	option peerdns '1'
	option defaultroute '1'
	# MTU 1500 is set deliberately, on evidence rather than theory: this is what
	# the device runs under ROOTer today, and lowering it breaks the owner's work
	# VPN -- an encapsulating tunnel needs the full 1500 underneath it, and when
	# the outer MTU is smaller the tunnel's own packets need fragmentation that
	# path-MTU discovery frequently fails to negotiate.
	#
	# Forcing 1500 is only harmful when the carrier's real MTU is lower, which
	# would show up as small requests working while large transfers and some
	# HTTPS sites hang. That is not the case on this carrier and APN. If it ever
	# changes, compare against what the modem reports: ip link show wwan0
	option mtu '1500'
	# MSS clamping stays enabled on the wan zone (mtu_fix) regardless. It clamps
	# TCP to the interface MTU and only affects TCP, so it does not interfere
	# with a UDP or ESP tunnel.
