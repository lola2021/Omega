config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00::/48'
	# Spread receive processing across both MIPS cores instead of pinning it to
	# CPU0. Worth having here because the cellular WAN arrives over USB, and USB
	# interrupt handling on one core is a real bottleneck on this SoC. Toggle it
	# under Network -> Interfaces -> Global network options if it ever hurts.
	option packet_steering '1'

config device 'br-lan'
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option metric '20'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'
	option metric '20'

# ==============================================================================
# MBIM Cellular Interface Configuration
# ==============================================================================
config interface 'wan_cellular'
	option proto 'mbim'
	option device '/dev/cdc-wdm0'
	option apn 'internet'
	option pdptype 'ipv4'
	option metric '10'
	option auto '1'
	option peerdns '1'
	option defaultroute '1'
	# MTU is deliberately NOT set. On MBIM the network dictates the usable MTU
	# and netifd applies whatever the modem reports; pinning 1500 on a path whose
	# real MTU is lower (carriers commonly hand out 1428-1500) black-holes large
	# packets instead of raising throughput. MSS clamping on the wan zone
	# (mtu_fix, already enabled) is what makes TCP behave across that boundary.
	# After first boot, read the real value with: ip link show wwan0
